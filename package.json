{
  "name": "erdes-group-recruitment",
  "version": "0.1.0",
  "private": true,
  "description": "Portal rekrutmen Erdes Group — Next.js, TypeScript, dan Google Sheets.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sheet:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-sheet.ts",
    "admin:create": "node --conditions=react-server --import tsx scripts/admin-create.ts",
    "admin:set-password": "node --conditions=react-server --import tsx scripts/admin-set-password.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.1",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "googleapis": "189.0.0",
    "jose": "6.2.15",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
