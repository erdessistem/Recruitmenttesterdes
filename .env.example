# ── Application ────────────────────────────────────────────────────────────────
# Base URL used in generated tracking links. Use the production domain on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# At least 32 random characters for signing admin session cookies.
AUTH_SECRET=replace-with-at-least-32-random-characters

# ── Google Sheets ──────────────────────────────────────────────────────────────
# Optional during implementation batches 1–6. Required for live data.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep escaped newlines in .env.local, e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# ── Seed scripts only (not required at runtime) ───────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Reserved for future shared rate limiting; not connected yet ───────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
